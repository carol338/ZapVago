# Banco de dados
DATABASE_URL="postgresql://user:password@localhost:5432/zapvago"

# Autenticação
NEXTAUTH_SECRET="seu-secret-aqui"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Business Cloud API — cada negócio conecta o PRÓPRIO Phone Number ID
# e token de acesso pelo onboarding (Business.whatsappProviderConfig). Estas
# variáveis do .env só servem de FALLBACK para desenvolvimento, antes de
# qualquer negócio ter conectado o próprio número.
WHATSAPP_API_TOKEN="seu-token-meta"
WHATSAPP_PHONE_NUMBER_ID="seu-phone-number-id"
WHATSAPP_VERIFY_TOKEN="seu-token-verificacao"
# App Secret do app na Meta — usado para validar a assinatura X-Hub-Signature-256
# de cada webhook recebido (Configurações Básicas do App no Meta for Developers)
WHATSAPP_APP_SECRET="seu-app-secret-meta"

# Mercado Pago — Access Token de produção, usado tanto para criar cobranças
# quanto para o webhook buscar o pagamento real na hora de confirmar (nunca
# confiamos no payload da notificação em si)
MERCADOPAGO_ACCESS_TOKEN="seu-access-token-mercadopago"

# Claude (Anthropic)
CLAUDE_API_KEY="sk-ant-api-key"
CLAUDE_MODEL_COMPLEX="claude-sonnet-5"
CLAUDE_MODEL_SIMPLE="claude-haiku-4-5-20251001"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Modo mock: quando "true", ZapVago simula respostas do WhatsApp e do Claude
# sem gastar créditos de API. Use para testar o fluxo antes de ter as chaves.
MOCK_MODE="true"

# Segredo para autorizar chamadas ao endpoint de cron (relatório mensal, lembretes)
CRON_SECRET="troque-por-um-valor-aleatorio"

# Web Push (notificações em tempo real no navegador do dono) — gere com
# `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY="chave-publica-vapid"
VAPID_PRIVATE_KEY="chave-privada-vapid"
VAPID_SUBJECT="mailto:contato@zapvago.app"
