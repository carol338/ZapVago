// ZapVago — schema do banco de dados
// Micro SaaS de agendamento inteligente via WhatsApp

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                     String    @id @default(cuid())
  name                   String
  slug                   String    @unique
  category               Category
  phone                  String    @unique
  address                String?
  timezone               String    @default("America/Sao_Paulo")
  whatsappConnected      Boolean   @default(false)
  whatsappProviderConfig Json?
  plan                   Plan      @default(FREE) // limites/features em src/lib/plan-limits.ts

  // Página pública (vitrine do negócio)
  logo           String?
  coverImage     String?
  colorPrimary   String?
  colorSecondary String?

  // settings: workingHours, blockedSlots, slotDuration, reminderHours,
  // autoConfirm, allowCancel, cancelDeadlineHours, language, timezone
  settings Json @default("{}")

  services      Service[]
  professionals Professional[]
  appointments  Appointment[]
  clients       Client[]
  conversations Conversation[]
  loyaltyRules  LoyaltyRule[]
  flashSales    FlashSale[]
  waitingList   WaitingListEntry[]
  waitingListEvents WaitingListEvent[]
  silentRules   SilentRule[]
  bookingTokens BookingToken[]
  pushSubscriptions PushSubscription[]
  integrationFailures IntegrationFailure[]
  owner         Owner?

  createdAt DateTime @default(now())
}

model Owner {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String   @unique
  password   String
  phone      String

  // notifyOn: { newAppointment, payment, humanRequested, cancellation, noShowRisk,
  //   dailyReport, weeklyReport, monthlyReport, sentimentAlert, channel }
  // channel: "whatsapp" | "push" | "both" — todos os toggles default true se ausentes.
  notifyOn Json @default("{}")

  lastMonthlyReportAt DateTime? // usado pra reconhecer resposta "sim"/"feirão" ao relatório mensal

  // LGPD — comprovação de consentimento (Art. 8º).
  consentTermsAt      DateTime? // aceite dos Termos de Uso + Política de Privacidade no cadastro
  consentMarketing     Boolean   @default(false) // opcional: autoriza comunicações sobre o produto
  dataProcessingAckAt DateTime? // ciência, no onboarding, de que trata dados pessoais de clientes finais

  createdAt DateTime @default(now())
}

// LGPD Art. 18, VI — registro de que uma conta foi excluída a pedido do
// titular, sem nenhum dado pessoal (só a data), pra fins de auditoria interna
// (ex: comprovar atendimento ao pedido em caso de reclamação na ANPD).
model AccountDeletionLog {
  id        String   @id @default(cuid())
  deletedAt DateTime @default(now())
}

model Service {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  duration      Int // minutos
  price         Float
  color         String   @default("#4F46E5")
  category      String? // "cabelo", "barba", "unhas", "pele", "consulta"
  active        Boolean  @default(true)
  order         Int      @default(0)
  comboOf       String[] // IDs de serviços que formam combo com este
  comboDiscount Float? // percentual de desconto no combo
  image         String? // foto do serviço na página pública
  description   String? // descrição curta na página pública

  appointments Appointment[]
  waitingListEntries WaitingListEntry[]
  bookingTokens BookingToken[]

  @@index([businessId])
}

model Professional {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  color      String   @default("#10B981")
  serviceIds String[] // IDs dos serviços que este profissional faz
  active     Boolean  @default(true)
  photo      String? // foto do profissional na página pública

  appointments Appointment[]
  bookingTokens BookingToken[]

  @@index([businessId])
}

model Client {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  language   String   @default("pt-BR")
  notes      String?
  tags       String[] // "vip", "fiel", "novo", "sumido", "problema"
  alergias   String[] // "amônia", "látex", "parabenos"

  // preferencias: { professionalPreference, servicePreference, bestDays, bestTimes }
  preferencias Json @default("{}")

  totalVisits         Int       @default(0)
  totalSpent          Float     @default(0)
  lastVisitAt         DateTime?
  avgIntervalDays      Float?
  noShowCount          Int       @default(0)
  noShowRate           Float     @default(0)
  cancelLateCount      Int       @default(0) // cancelou com menos de 24h de antecedencia
  loyaltyPoints        Int       @default(0)
  predictedNoShowRisk  Float     @default(0)
  lastContactedAt      DateTime?
  silencedUntil        DateTime?
  requiresPrepayment   Boolean   @default(false)

  createdAt DateTime @default(now())

  appointments  Appointment[]
  conversations Conversation[]
  waitingList   WaitingListEntry[]
  bookingTokens BookingToken[]
  clientNotes   ClientNote[]

  @@unique([businessId, phone])
  @@index([businessId])
}

// Notas do dono sobre o cliente — Prontuário Inteligente.
model ClientNote {
  id         String   @id @default(cuid())
  businessId String
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime @default(now())

  @@index([clientId])
}

model Appointment {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])

  date    DateTime
  endTime DateTime
  status  Status   @default(CONFIRMED)
  notes   String?
  source  Source   @default(WHATSAPP)

  reminderSent24  Boolean @default(false)
  reminderSent1   Boolean @default(false)
  clientConfirmed Boolean @default(false)
  noShowPredicted Float   @default(0)
  upsellOffered   Boolean @default(false)
  upsellAccepted  Boolean @default(false)

  // Pagamento (Página de Agendamento — Parte 3)
  price           Float?  // valor final cobrado (pode diferir do service.price por desconto/combo)
  paymentMethod   String? // "pix" | "card" | "local"
  paymentStatus   String  @default("NONE") // "NONE" | "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  paymentId       String? // id do pagamento no provedor (Mercado Pago)
  paymentDiscount Float   @default(0)
  paymentExpiresAt DateTime? // prazo do Pix (15min) — expirado e não pago = cancelado

  cancelledAt   DateTime? // quando foi cancelado (pra saber se foi em cima da hora)
  riskNotifiedAt DateTime? // evita notificar o dono mais de uma vez pro mesmo risco alto

  // Bloco 3 — Proativo
  flashSaleId String? // se veio de um link de Feirão (Diferencial 6)
  fromWaitingList Boolean @default(false) // se veio de uma oferta de Lista de Espera aceita
  loyaltyRewardApplied Boolean @default(false) // se usou uma recompensa de fidelidade nesse agendamento

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, date])
  @@index([professionalId, date])
  @@index([flashSaleId])
}

// Link de agendamento com pagamento — gerado pelo bot ou pelo dono para um
// cliente específico. Expira em 24h. Usado na página pública
// /{subdomain}/agendar/{token}.
model BookingToken {
  id             String        @id @default(cuid())
  token          String        @unique
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?      @relation(fields: [serviceId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([businessId])
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum Category {
  BARBER
  SALON
  AESTHETIC_CLINIC
  MANICURE
  DENTAL_CLINIC
  TATTOO_STUDIO
  PET_SHOP
  OTHER
}

enum Status {
  CONFIRMED
  PENDING_CONFIRMATION
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum Source {
  WHATSAPP
  MANUAL
  PHONE_CALL
  FLASH_SALE
}

model Conversation {
  id          String             @id @default(cuid())
  businessId  String
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?            @relation(fields: [clientId], references: [id])
  clientPhone String
  clientName  String?
  status      ConversationStatus @default(BOT_HANDLING)

  // [{role:"client"|"bot"|"owner", content, timestamp, sentiment}]
  messages Json @default("[]")

  sentiment      String?
  language       String   @default("pt-BR")
  summary        String?
  needsAttention Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
}

enum ConversationStatus {
  BOT_HANDLING
  NEEDS_HUMAN
  HUMAN_HANDLING
  RESOLVED
}

model LoyaltyRule {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  visitsRequired  Int
  rewardServiceId String
  rewardDiscount  Float
  active          Boolean  @default(true)
}

model FlashSale {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  discountPercent Float
  serviceIds      String[]
  professionalIds String[]
  startDate       DateTime
  endDate         DateTime
  daysOfWeek      Int[] // 1=seg ... 7=dom
  timeStart       String // "10:00"
  timeEnd         String // "14:00"
  targetClients   String[] // "sumido", "novo", "vip", "todos"
  message         String?
  sentCount       Int      @default(0)
  bookedCount     Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model WaitingListEntry {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  preferredDate   DateTime
  flexibleDates   Boolean  @default(true)
  preferredPeriod String? // "morning", "afternoon", "evening"
  notified        Boolean  @default(false)

  // Oferta ativa em aberto (Bloco 3 Parte 1) — quando notified=true, esses
  // campos guardam QUAL vaga foi oferecida, pra poder confirmar (SIM) ou
  // expirar em 15min e passar pro próximo candidato da mesma vaga.
  notifiedAt              DateTime?
  offeredAppointmentId    String?
  excludedAppointmentIds  String[]  @default([]) // vagas que já expiraram pra esse cliente (não reoferecer)

  // Resultado final (feedback visual — não deleta mais ao confirmar/recusar,
  // só marca como resolvido e some da fila ativa).
  resolvedAt DateTime?
  resolution String? // "booked" | "declined"

  createdAt       DateTime @default(now())
}

// Log de eventos da Lista de Espera Ativa (Bloco 3 Parte 1) — permite ver o
// fluxo completo (cancelamento → notificação → resposta → agendamento) sem
// depender do WhatsApp real, já que tudo roda em MOCK_MODE por enquanto.
model WaitingListEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String // "cancelled" | "notified" | "replied_yes" | "replied_no" | "replied_skip" | "booked" | "expired"
  message    String
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// Bloco 3 Parte 5 — Notificações em tempo real (Web Push do navegador do dono)
model PushSubscription {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// Fallback de integrações externas — cada falha real (fora de MOCK_MODE) do
// WhatsApp, Mercado Pago ou Claude é registrada aqui via src/lib/alerting.ts,
// pra alimentar o painel "Status das Integrações" em Configurações e disparar
// aviso proativo ao dono quando o mesmo serviço falha 3x numa hora.
model IntegrationFailure {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service    String // "whatsapp" | "mercadopago" | "claude" | "cron"
  error      String
  context    Json?
  occurredAt DateTime @default(now())

  @@index([businessId, service, occurredAt])
}

// Diferencial 9 — Modo Silencioso: regras automáticas para clientes problemáticos
model SilentRule {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  trigger     String // "noshow_3x" | "price_asked_3x_no_book" | "late_cancel_2x"
  action      String // "require_prepayment" | "silence_offers_30d" | "require_confirmation"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Contador de vagas da oferta de lançamento (14 dias grátis) exibido na landing page.
// Uma linha única controla o estado — incrementado a cada novo cadastro em /api/auth/register.
model LaunchOffer {
  id          String   @id @default(cuid())
  totalSpots  Int      @default(50)
  filledSpots Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}
